# Almacena TODAS las flags en UN SOLO número
var flags: int = 0

# ACTIVAR un flag
func activar(flag: int) -> void:
	flags |= 1 << flag  # Pone ese bit en 1


# DESACTIVAR un flag
func desactivar(flag: int) -> void:
	flags &= ~(1 << flag)  # Pone ese bit en 0


# ALTERNAR (activar si estaba apagado / apagar si estaba encendido)
func alternar(flag: int) -> void:
	flags ^= 1 << flag


# COMPROBAR si está activado (devuelve true o false)
func esta_activado(flag: int) -> bool:
	return (flags & (1 << flag)) != 0
